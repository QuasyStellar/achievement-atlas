{
  "name": "achievement-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Серверная часть системы внутриигровых достижений с NFT — TON testnet",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "start": "tsx apps/server/src/index.ts",
    "test": "vitest run tests/server",
    "test:sandbox": "vitest run contracts/tests",
    "test:e2e": "tsx tools/e2e.ts",
    "wallet:prepare": "tsx tools/prepare-wallet.ts",
    "wallet:balance": "tsx tools/wallet-balance.ts",
    "contracts:build": "tsx tools/compile-contracts.ts",
    "deploy:testnet": "tsx tools/deploy-testnet.ts",
    "verify:testnet": "tsx tools/verify-testnet.ts",
    "operator:create": "tsx tools/create-operator.ts",
    "simulator": "tsx tools/simulate-game.ts"
  },
  "dependencies": {
    "@ton-community/func-js": "^0.11.0",
    "@ton/core": "^0.63.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sqlite3": "^5.1.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ton/sandbox": "^0.38.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.55.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
